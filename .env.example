# Copy to .env and fill in what you have. backend/run.sh loads it automatically.
# Everything is optional: with no keys the app runs in demo mode (AI falls back to plain text,
# email and Telegram are logged as SIMULATED).

# ---- Free AI (pick any; "auto" tries gemini -> groq -> openrouter)
AI_PROVIDER=auto
# Google AI Studio, free tier, no card: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Groq, free tier, no card: https://console.groq.com/keys
GROQ_API_KEY=
# OpenRouter, models ending in :free cost nothing: https://openrouter.ai/keys
OPENROUTER_API_KEY=
# Free model names change over time; update these if a request fails with "model not found".
# GEMINI_MODEL=gemini-2.0-flash
# GROQ_MODEL=llama-3.1-8b-instant
# OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free

# ---- Free Telegram bot: talk to @BotFather on Telegram, send /newbot, paste the token here
TELEGRAM_TOKEN=
# Your own chat id (message @userinfobot) so "Send test to me" reaches you
TEST_TELEGRAM_CHAT_ID=

# ---- Free email through a Gmail account (turn on 2-step verification, then create an App Password)
# https://myaccount.google.com/apppasswords
# Leave MAIL_HOST unset to keep email in SIMULATED mode.
# MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=
MAIL_PASS=
MAIL_FROM=

# ---- Security (required in production, see "Production deployment" in the README)
# Signing secret for login tokens, 32+ characters. Generate one with: openssl rand -base64 48
# The prod profile refuses to start while this is still the placeholder below.
JWT_SECRET=change-me-to-a-random-string-at-least-32-characters
# Browser origin allowed to call the API directly (the Vite dev server by default).
# CORS_ORIGIN=http://localhost:5173
# Demo users and sample data are created on first start. Set to false outside local development.
# SEED_DEMO_DATA=true
# First administrator, created when it does not exist yet (password: 12+ characters).
# ADMIN_EMAIL=
# ADMIN_PASSWORD=
# Webhooks may not call loopback or private addresses unless this is true (local testing only).
# ALLOW_PRIVATE_WEBHOOKS=false

# ---- Database (default: embedded H2 file under backend/data). Required by docker-compose.yml.
# DB_URL=jdbc:postgresql://localhost:5432/flowedu
# DB_USER=flowedu
DB_PASS=
# Hibernate schema handling: update (default), validate or none.
# DDL_AUTO=update

# ---- docker-compose only: host port for the web UI
# WEB_PORT=8080
